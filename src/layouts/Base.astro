---
import Icon from '../components/Icon.astro';
import MsgrRow from '../components/MsgrRow.astro';
import { site, data, LANGS, url, absUrl, asset, tr, t, msgrLink, schemaFor, type Lang, type Page } from '../lib/site';

interface Props { lang: Lang; page: Page; title: string; description?: string }
const { lang, page, title, description } = Astro.props;
const T = t(lang);
const desc = description || tr(site.description, lang);
const og = absUrl('index', 'ru') + 'assets/og.png';
const schema = schemaFor(page, lang);
const promo = data.promo;
const nav: [string, string][] = [
  ['index', T.nav_home], ['services', T.nav_services], ['about', T.nav_about],
  ['gallery', T.nav_gallery], ['faq', T.nav_faq], ['contacts', T.nav_contacts],
];
const fabKeys = ['wa', 'tg', 'vb', 'ig', 'ph'] as const;
const fabNames: Record<string, string> = { wa: 'WhatsApp', tg: 'Telegram', vb: 'Viber', ig: 'Instagram', ph: T.call };
const cfg = {
  lang, name: site.name, whatsapp: site.whatsapp, telegram: site.telegram,
  t: { d: T.promo_d, h: T.promo_h, m: T.promo_m, msg: T.f_msg, copied: T.f_copied, copy: T.f_copy },
};
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  {page !== '404' && <link rel="canonical" href={absUrl(page, lang)} />}
  {page !== '404' && LANGS.map((l) => <link rel="alternate" hreflang={l} href={absUrl(page, l)} />)}
  {page !== '404' && <link rel="alternate" hreflang="x-default" href={absUrl(page, 'ru')} />}

  <!-- Превью ссылки в мессенджерах и соцсетях -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={absUrl(page === '404' ? 'index' : page, lang)} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={og} />

  <meta name="theme-color" content="#f5f0e8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e0d0c" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={asset('assets/favicon.png')} type="image/png" />
  <link rel="apple-touch-icon" href={asset('assets/apple-touch-icon.png')} />
  <link rel="manifest" href={asset('site.webmanifest')} />
  <link rel="sitemap" href={asset('sitemap-index.xml')} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={asset('assets/style.css')} />

  <!-- Тема применяется до отрисовки, чтобы не было вспышки -->
  <script is:inline>
    (function () {
      var th = null;
      try { th = localStorage.getItem('aura-theme'); } catch (e) {}
      if (!th) th = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = th;
      document.documentElement.classList.add('js');
    })();
  </script>
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body data-page={page}>
  <a class="skip-link" href="#content">{T.skip}</a>

  {promo.enabled && (
    <div class="promo" id="promo" data-until={promo.until} hidden>
      <div class="wrap promo-inner">
        <span class="promo-dot" aria-hidden="true"></span>
        <p>{tr(promo.text, lang)}</p>
        <span class="promo-timer"><span class="promo-left">{T.promo_left}</span> <b data-cd></b></span>
        {promo.link && <a class="promo-link" href={url(promo.link, lang)}>{T.promo_more} →</a>}
        <button class="promo-close" aria-label={T.close}>×</button>
      </div>
    </div>
  )}

  <header class="header" id="header">
    <div class="wrap">
      <a href={url('index', lang)} class="logo"><img src={asset('assets/logo-bh.png')} alt="" width="36" height="38" /><span>{site.name}</span></a>
      <nav class="nav" aria-label={T.menu}>
        {nav.map(([p, label]) => (
          <a href={url(p, lang)} class={p === page ? 'active' : undefined} aria-current={p === page ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="header-cta">
        <div class="lang-switch">
          {LANGS.map((l) => (
            <a href={url(page === '404' ? 'index' : page, l)} hreflang={l} lang={l} class={l === lang ? 'active' : undefined}>{l.toUpperCase()}</a>
          ))}
        </div>
        <button class="icon-btn theme-toggle" aria-label={T.theme} title={T.theme}>
          <span class="i-sun"><Icon name="sun" /></span><span class="i-moon"><Icon name="moon" /></span>
        </button>
        <a class="phone" href={`tel:${site.phoneRaw}`}>{site.phone}</a>
        <a class="btn btn-primary btn-sm" href={msgrLink('wa', lang)} target="_blank" rel="noopener">{T.book}</a>
        <button class="burger" aria-label={T.menu} aria-expanded="false" aria-controls="mobile-menu"><span></span></button>
      </div>
    </div>
  </header>
  <div class="mobile-menu" id="mobile-menu">
    {nav.map(([p, label]) => <a href={url(p, lang)}>{label}</a>)}
    <div class="mm-contacts"><MsgrRow keys={['wa', 'tg', 'vb', 'ig', 'ph']} lang={lang} /></div>
  </div>

  <main id="content" tabindex="-1">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a href={url('index', lang)} class="logo"><img src={asset('assets/logo-bh.png')} alt="" width="36" height="38" /><span>{site.name}</span></a>
          <p>{T.footer_about}</p>
          <MsgrRow keys={['wa', 'tg', 'vb', 'ig']} lang={lang} />
        </div>
        <div><h2 class="f-title">{T.footer_nav}</h2><ul>
          {nav.map(([p, label]) => <li><a href={url(p, lang)}>{label}</a></li>)}
        </ul></div>
        <div><h2 class="f-title">{T.footer_services}</h2><ul>
          {data.services.categories.map((c) => <li><a href={url(`services#${c.id}`, lang)}>{tr(c.title, lang)}</a></li>)}
        </ul></div>
        <div><h2 class="f-title">{T.footer_contacts}</h2><ul>
          <li><a href={`tel:${site.phoneRaw}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{tr(site.address, lang)}</li>
          <li>{tr(site.hours, lang)}</li>
        </ul></div>
      </div>
      <div class="footer-bottom">
        <span>© {year} {site.name}. {T.footer_rights}</span>
        <a href={url('privacy', lang)}>{T.f_privacy.charAt(0).toUpperCase() + T.f_privacy.slice(1)}</a>
        <a href={url('contacts', lang)}>{T.footer_book}</a>
      </div>
    </div>
  </footer>

  <div class="fab" id="fab">
    <button class="fab-main" aria-label={T.write_us} aria-expanded="false"><Icon name="chat" /></button>
    <div class="fab-list">
      {fabKeys.map((k) => (
        <a class={`msgr ${k}`} href={msgrLink(k, lang)} tabindex="-1" {...(k !== 'ph' ? { target: '_blank', rel: 'noopener' } : {})}>
          <Icon name={k} /><span>{fabNames[k]}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="sticky-cta" id="sticky-cta" aria-hidden="true">
    <span>{T.sticky_label}</span>
    <a class="btn btn-primary btn-sm" href={msgrLink('wa', lang)} target="_blank" rel="noopener" tabindex="-1"><Icon name="wa" />{T.book}</a>
  </div>

  <script is:inline define:vars={{ cfg }}>window.AURA = cfg;</script>
  <script is:inline src={asset('assets/main.js')} defer></script>
</body>
</html>
